# VA-11 Hall-A (010086500D3C8000, base game v0): the VAllhalla bartending panel. Included from
# CMakeLists.txt. Defines:
#   dsmod-va11        the title module 010086500D3C8000 (EXCLUDE_FROM_ALL): reads the shaker, Ice,
#                     Aging, mixing and the night's money from the game, decodes the game's sprites,
#                     font and OGG sounds from the player's own romfs (game.win) at runtime
#   dsmod-va11-test   test (BUILD_TESTING, not Android): fake guest memory + a synthetic game.win
# va11_jill_faces.h is generated by tools/va11-hall-a/gen_jill_faces.py from va11_jill_faces/*.tsv.
# stb_vorbis builds in a translation unit of its own (va11_stb_vorbis.cpp): its short internal
# macro names would clash with the module's.
set(VA11_SOURCES
    "${CMAKE_CURRENT_LIST_DIR}/va11_gm_reader.h"
    "${CMAKE_CURRENT_LIST_DIR}/va11_jill_faces.h"
    "${CMAKE_CURRENT_LIST_DIR}/va11_stb_vorbis.cpp")
set(VA11_INCLUDE_DIRECTORIES
    "${EDEN_SOURCE_ROOT}/externals/stb"
    "${CMAKE_CURRENT_LIST_DIR}/third_party")

dsmod_add_module(dsmod-va11 EXCLUDE_FROM_ALL
    TITLE 010086500D3C8000
    SOURCES 010086500D3C8000.cpp ${VA11_SOURCES}
    EXPORTS eden_dsmod_get_module eden_dsmod_get_extensions eden_dsmod_get_font_extensions
    INCLUDE_DIRECTORIES ${VA11_INCLUDE_DIRECTORIES})
if(BUILD_TESTING AND NOT ANDROID)
    dsmod_add_test(dsmod-va11 KEEP_ASSERTS
        SOURCES 010086500D3C8000_test.cpp 010086500D3C8000.cpp ${VA11_SOURCES}
        INCLUDE_DIRECTORIES ${VA11_INCLUDE_DIRECTORIES})
endif()
