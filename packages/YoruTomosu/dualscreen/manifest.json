  },
  "_about": "2026-10-16 round 2 (owner feedback): a new Log row slides in from above with older rows sliding down (Follow newest only); Log/Option/CG tabs are now separate manifest pages that cross-fade on switch; Log's own header gained the same text-size controls as the Option page (shared state). Round 1: native drag-to-scroll Log/CG (ScrollRegion) replaces the pan_zoom raster body; Latest/Oldest at the scrollbar ends. No game/patch assets bundled. Independent local interactions only.",
  "_development": "Private development slice. Pinch-to-zoom on the Log was tried and dropped (mod_input.cpp's gesture priority gives any on_pinch widget the whole single-finger gesture before the ScrollRegion is ever consulted, the same bug the owner reported for the old pan_zoom body) -- text size lives on both the Log and Option pages instead. Android device validation pending.",
  "haptics": {
    "enabled": true,
    "respect_system": true,
    "tap": "light",
    "select": "light",
    "swipe": "light",
    "hold": "click",
    "refused": "light",
    "drag": "light"
  },
  "flags": {
    "opt.scroll_speed": 1,
    "opt.follow_newest": 1
  },
  "persist_flags": [
    "opt.scroll_speed",
    "opt.follow_newest"
  ],
  "derived": [
    {
      "name": "log.live_slow",
      "expr": "(ui.page.0 != 0) && (@flag:opt.scroll_speed == 0)"
    },
    {
      "name": "cg.live_slow",
      "expr": "(ui.cg_grid != 0) && (@flag:opt.scroll_speed == 0)"
    },
    {
      "name": "opt.sel.speed_slow",
      "expr": "@flag:opt.scroll_speed == 0"
    },
    {
      "name": "log.live_normal",
      "expr": "(ui.page.0 != 0) && (@flag:opt.scroll_speed == 1)"
    },
    {
      "name": "cg.live_normal",
      "expr": "(ui.cg_grid != 0) && (@flag:opt.scroll_speed == 1)"
    },
    {
      "name": "opt.sel.speed_normal",
      "expr": "@flag:opt.scroll_speed == 1"
    },
    {
      "name": "log.live_fast",
      "expr": "(ui.page.0 != 0) && (@flag:opt.scroll_speed == 2)"
    },
    {
      "name": "cg.live_fast",
      "expr": "(ui.cg_grid != 0) && (@flag:opt.scroll_speed == 2)"
    },
    {
      "name": "opt.sel.speed_fast",
      "expr": "@flag:opt.scroll_speed == 2"
    },
    {
      "name": "opt.sel.follow_on",
      "expr": "@flag:opt.follow_newest != 0"
    },
    {
      "name": "opt.sel.follow_off",
      "expr": "@flag:opt.follow_newest == 0"
    },
    {
      "name": "opt.log_reset_combined",
      "expr": "log.latest_nonce + ((@flag:opt.follow_newest != 0) * log.content_rev)"
    },
    {
      "name": "log.slide_dy_gated",
      "expr": "log.slide_dy * (@flag:opt.follow_newest != 0)"
    }
  ],
