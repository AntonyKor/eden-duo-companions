        "easing": "ease_in_out"
      },
      "when_not_equal": {
        "page": "log",
        "transition": "fade",
        "duration_ms": 260,
        "easing": "ease_in_out"
      }
    },
    {
      "point": "ui.full_cg",
      "equals": 1,
      "when_equal": {
        "page": "cg-full",
        "transition": "fade",
        "duration_ms": 220,
        "easing": "ease_in_out"
      },
      "when_not_equal": {
        "page": "cg",
        "transition": "fade",
        "duration_ms": 180,
        "easing": "ease_in_out"
      }
    },
    {
      "point": "module_error",
      "equals": 1,
      "when_equal": {
        "page": "waiting",
        "transition": "fade",
        "duration_ms": 220,
        "easing": "ease_in_out"
      }
    },
