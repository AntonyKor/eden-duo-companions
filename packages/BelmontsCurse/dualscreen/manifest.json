    {
      "name": "ui.native",
      "all_nonzero": [
        "ui.supported",
        "belmont.native_assets_ready"
      ]
    },
    {
      "name": "ui.map",
      "all_nonzero": [
        "ui.native",
        "belmont.ui_world",
        "belmont.map_ready",
        "belmont.marker_ready"
      ]
    },
    {
      "name": "ui.title",
      "all_nonzero": [
        "ui.native",
        "belmont.ui_title"
      ]
    },
    {
      "name": "ui.loading",
      "all_nonzero": [
        "ui.native",
        "belmont.ui_loading"
      ]
    },
    {
      "name": "ui.not_map",
      "cmp": "eq",
      "a": "ui.map",
      "b": 0
    },
    {
      "name": "ui.custom",
      "cmp": "ne",
      "a": "view_custom:belmont_map",
      "b": 0
    },
    {
      "name": "ui.follow",
      "cmp": "eq",
      "a": "view_custom:belmont_map",
      "b": 0
    },
    {
      "name": "ui.wait",
      "expr": "ui.native && !ui.title && !ui.loading && !ui.map"
    },
    {
      "name": "ui.wait_art",
      "any_nonzero": [
        "ui.loading",
        "ui.wait"
      ]
    },
    {
      "name": "ui.sub",
      "expr": "ui.map && @flag:ui.area_tier == 0"
    },
    {
      "name": "ui.area",
      "expr": "ui.map && @flag:ui.area_tier == 1"
    },
    {
      "name": "ui.focus_on",
      "expr": "ui.map && (@flag:ui.area_tier == 1 || 'view_custom:belmont_map' != 0)"
    },
    {
      "name": "ui.focus_sub",
      "expr": "ui.map && @flag:ui.area_tier == 0 && 'view_custom:belmont_map' != 0"
    },
    {
      "name": "ui.enforce",
      "expr": "@flag:ui.area_tier != @flag:ui.area_applied || (!ui.map && 'view_custom:belmont_map' != 0)"
    },
    {
      "name": "ui.vx0",
      "expr": "@flag:ui.area_tier == 1 ? belmont.area_x0 : belmont.view_x0"
    },
    {
      "name": "ui.vy0",
      "expr": "@flag:ui.area_tier == 1 ? belmont.area_y0 : belmont.view_y0"
    },
    {
      "name": "ui.vx1",
      "expr": "@flag:ui.area_tier == 1 ? belmont.area_x1 : belmont.view_x1"
    },
    {
      "name": "ui.vy1",
      "expr": "@flag:ui.area_tier == 1 ? belmont.area_y1 : belmont.view_y1"
    }
